# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API (optional - for custom backend)
VITE_API_URL=/api

# Stripe (for Checkout/Billing - card input)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# OpenClaw Edge Function secrets (set via Supabase Dashboard > Edge Functions > Secrets):
# OPENCLAW_WEBHOOK_SECRET - for webhook signature verification
# OPENCLAW_API_URL - optional, for external OpenClaw API
